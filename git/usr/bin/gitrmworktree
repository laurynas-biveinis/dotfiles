#!/bin/zsh
# Remove a linked worktree and its branch once merged into master.
# --force overrides safety checks and discards local and remote branch work.

set -euo pipefail

declare -i FORCE=0

while (($# > 0)); do
	case "$1" in
	--force)
		FORCE=1
		shift
		;;
	*)
		if [[ -z "${WORKTREE_PATH:-}" ]]; then
			readonly WORKTREE_PATH="$1"
		fi
		shift
		;;
	esac
done

if [ -z "${WORKTREE_PATH:-}" ]; then
	>&2 echo "Usage: $0 [--force] <worktree-path>"
	exit 3
fi

readonly WORKTREE_DIR="$WORKTREE_PATH:t"

pushd "$WORKTREE_PATH" || exit 1

WORKTREE_GIT_DIR=$(git rev-parse --absolute-git-dir)
readonly WORKTREE_GIT_DIR
COMMON_GIT_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
readonly COMMON_GIT_DIR

git_common() {
	git --git-dir="$COMMON_GIT_DIR" "$@"
}

change_to_force_push_directory() {
	local push_is_bare push_candidate push_inside push_top push_git_dir
	local -a push_records
	push_is_bare=$(git_common rev-parse --is-bare-repository)
	if [ "$push_is_bare" = true ]; then
		cd "$COMMON_GIT_DIR"
		return
	fi
	push_records=("${(@0)$(git_common worktree list --porcelain -z)}")
	push_candidate="${push_records[1]#worktree }"
	if push_inside=$(git -C "$push_candidate" rev-parse --is-inside-work-tree) &&
		[ "$push_inside" = true ] &&
		push_top=$(git -C "$push_candidate" rev-parse --show-toplevel) &&
		push_git_dir=$(git -C "$push_candidate" rev-parse --absolute-git-dir) &&
		[ "${push_top:A}" = "${push_candidate:A}" ] &&
		[ "${push_git_dir:A}" = "${COMMON_GIT_DIR:A}" ]; then
		cd "$push_candidate"
	else
		cd "$WORKTREE_ABSOLUTE_PATH"
	fi
}

delete_remote_branch() {
	if [ -z "$REMOTE_NAME" ] || [ "$REMOTE_NAME" = . ]; then
		>&2 echo "No external push remote for branch $BRANCH_NAME, not deleting it remotely"
	elif ! git_common push "$REMOTE_NAME" -d "$BRANCH_NAME"; then
		>&2 echo "Failed to delete the remote branch, perhaps it was already deleted"
		if [ $FORCE -eq 1 ]; then
			return 1
		fi
	fi
}

if [ $FORCE -ne 1 ]; then
	if [ "$WORKTREE_GIT_DIR" = "$COMMON_GIT_DIR" ]; then
		>&2 echo "$WORKTREE_PATH is not a linked worktree"
		popd || exit 1
		exit 3
	fi
	if [ "${COMMON_GIT_DIR:t}" != .git ]; then
		>&2 echo "Unsupported repository layout: $COMMON_GIT_DIR is not <main>/.git"
		popd || exit 1
		exit 3
	fi
	WORKTREE_PREFIX=$(git rev-parse --show-prefix)
	readonly WORKTREE_PREFIX
	if [ -n "$WORKTREE_PREFIX" ]; then
		>&2 echo "$WORKTREE_PATH is not the top of a worktree"
		popd || exit 1
		exit 3
	fi

	WORKTREE_STATUS=$(git status --porcelain --untracked-files=all --ignore-submodules=none)
	readonly WORKTREE_STATUS
	if [ -n "$WORKTREE_STATUS" ]; then
		>&2 echo "Worktree $WORKTREE_DIR has uncommitted changes:"
		>&2 echo "$WORKTREE_STATUS"
		popd || exit 1
		exit 4
	fi
fi

WORKTREE_ABSOLUTE_PATH=$(git rev-parse --show-toplevel)
readonly WORKTREE_ABSOLUTE_PATH

BRANCH_NAME=$(git branch --show-current)
readonly BRANCH_NAME
if [ $FORCE -ne 1 ] && [ -z "$BRANCH_NAME" ]; then
	>&2 echo "$WORKTREE_PATH is not on a branch (detached HEAD, or a rebase or bisect in progress)"
	popd || exit 1
	exit 3
fi

REMOTE_NAME=""
if [ -n "$BRANCH_NAME" ]; then
	REMOTE_NAME=$(git config branch."${BRANCH_NAME}".pushremote || echo "")
	if [ -z "${REMOTE_NAME}" ]; then
		REMOTE_NAME=$(git config remote.pushdefault || echo "")
	fi
	if [ -z "${REMOTE_NAME}" ]; then
		REMOTE_NAME=$(git config branch."${BRANCH_NAME}".remote || echo "")
		UPSTREAM_MERGE=$(git config branch."${BRANCH_NAME}".merge || echo "")
		readonly UPSTREAM_MERGE
		if [ $FORCE -ne 1 ] && [ -n "$REMOTE_NAME" ] && [ "$REMOTE_NAME" != . ] &&
			[ "$UPSTREAM_MERGE" != "refs/heads/$BRANCH_NAME" ]; then
			readonly UPSTREAM_BRANCH_REF="refs/remotes/$REMOTE_NAME/$BRANCH_NAME"
			if ! git show-ref --verify --quiet "$UPSTREAM_BRANCH_REF" ||
				! git merge-base --is-ancestor "$UPSTREAM_BRANCH_REF" "refs/heads/$BRANCH_NAME"; then
				REMOTE_NAME=""
			fi
		fi
	fi
fi
readonly REMOTE_NAME

# TODO(laurynas): replace hardcoded "master" with the default branch check,
# i.e. git remote show [remote-name] | grep 'HEAD branch'
readonly TRUNK_BRANCH=master
if [ $FORCE -ne 1 ] && [ "$BRANCH_NAME" = "$TRUNK_BRANCH" ]; then
	>&2 echo "Refusing to delete $TRUNK_BRANCH, use git worktree remove instead"
	popd || exit 1
	exit 2
fi

if [ $FORCE -ne 1 ] && ! git submodule --quiet foreach --recursive '
	stash_symbolic_status=0
	git symbolic-ref --quiet refs/stash >/dev/null || stash_symbolic_status=$?
	stash_refs=$(git for-each-ref --format="%(refname)" refs/stash 2>&1) &&
		test -z "$stash_refs" &&
		test "$stash_symbolic_status" -eq 1 &&
		unpushed=$(git rev-list -n 1 HEAD --all --not --remotes) &&
		test -z "$unpushed" || {
		test -z "$stash_refs" || printf "%s\n" "$stash_refs" >&2
		>&2 echo "$displaypath has unpushed commits or a stash, or cannot be read"
		exit 1
	}
'; then
	popd || exit 1
	exit 2
fi

REMOTE_DELETE_STATUS=0
if [ $FORCE -eq 1 ]; then
	if [ "$WORKTREE_GIT_DIR" != "$COMMON_GIT_DIR" ] &&
		[ -n "$REMOTE_NAME" ] && [ "$REMOTE_NAME" != . ]; then
		change_to_force_push_directory
		if ! delete_remote_branch; then
			REMOTE_DELETE_STATUS=1
		fi
	fi
	cd "$COMMON_GIT_DIR"
else
	cd "$COMMON_GIT_DIR/.."
	if [ -n "$REMOTE_NAME" ] && [ "$REMOTE_NAME" != . ]; then
		git_common pull
	fi
fi

if [ $FORCE -ne 1 ]; then
	if ! git_common merge-base --is-ancestor "refs/heads/$BRANCH_NAME" "refs/heads/$TRUNK_BRANCH"; then
		>&2 echo "Branch $BRANCH_NAME checked out at $WORKTREE_DIR is not fully merged"
		popd || exit 1
		exit 2
	fi
fi

REMOVE_FLAGS=(--force)
if [ $FORCE -eq 1 ]; then
	REMOVE_FLAGS+=(--force)
fi
git_common worktree remove "${REMOVE_FLAGS[@]}" "$WORKTREE_ABSOLUTE_PATH"

if [ $FORCE -ne 1 ]; then
	delete_remote_branch
fi

if [ -n "$BRANCH_NAME" ]; then
	# The preflight checks master even when this branch's upstream is older.
	git_common branch -D "$BRANCH_NAME"
fi

if [ $FORCE -ne 1 ] && [ -n "$REMOTE_NAME" ] && [ "$REMOTE_NAME" != . ]; then
	git_common fetch --all -p
fi

exit "$REMOTE_DELETE_STATUS"
