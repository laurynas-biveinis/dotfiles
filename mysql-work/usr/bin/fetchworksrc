#!/bin/zsh

set -euo pipefail

autoload is_on_ac
autoload mysql_need_openssl_unlink_workaround
autoload mysql_maybe_unlink_openssl
autoload mysql_relink_openssl
autoload mysql_unlink_googletest

function fetch_and_maintain_repo() {
	declare -r repo="$1"

	declare -r fullpath="$WORK_SRC_ROOT/$repo"
	echo "Fetching & GCing $fullpath..."
	pushd "$fullpath" || return
	git fetch --all
	git gc --quiet
	popd || return
}

function pull_worktree() {
	declare -r worktree="$1"

	declare -r fullpath="$WORK_SRC_ROOT/$worktree"
	echo "Pulling $fullpath..."
	pushd "$fullpath" || return
	declare -i had_include=0 pull_status=0
	if cf_off; then
		had_include=1
	fi
	{ git pull && git submodule update; } || pull_status=$?
	if ((had_include)); then
		cf_on
	fi
	popd || return
	return "$pull_status"
}

function build_tree() {
	declare -r build_dir="$1"

	if ! is_on_ac; then
		echo Laptop is on battery: skipping build of "$build_dir"
		return 0
	fi
	pushd "$build_dir" || return 1
	echo "Building $build_dir..."
	time ninja || {
		popd
		return 1
	}
	date
	popd || return 1
	return 0
}

for repo in $WORK_REPOS_TO_PULL; do
	fetch_and_maintain_repo "$repo"
done

for worktree in $WORK_TREES_TO_UPDATE; do
	pull_worktree "$worktree"
done

mysql_unlink_googletest

declare -i fetchworksrc_status=0
for worktree in $WORK_TREES_TO_UPDATE; do
	declare full_worktree_path="$WORK_SRC_ROOT/$worktree"
	pushd "$full_worktree_path" || exit

	declare -i workaround_ssl
	if ! workaround_ssl=$(mysql_need_openssl_unlink_workaround); then
		popd
		exit 1
	fi

	if mysql_maybe_unlink_openssl $workaround_ssl; then
		for build_dir in "$full_worktree_path"/_build-*(N/); do
			if ! build_tree $build_dir; then
				fetchworksrc_status=1
			fi
		done
	else
		fetchworksrc_status=1
	fi

	mysql_relink_openssl $workaround_ssl || fetchworksrc_status=1

	popd || exit
done

exit "$fetchworksrc_status"
