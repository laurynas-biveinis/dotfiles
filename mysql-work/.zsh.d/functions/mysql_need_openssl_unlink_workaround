# -*- mode: sh; sh-shell: zsh; -*-

mysql_need_openssl_unlink_workaround() {
    autoload mysql_find_version_file
    autoload mysql_get_version
    autoload -Uz is-at-least

    if [[ $OSTYPE != darwin* ]]; then
        echo 0
        return 0
    fi

    declare version_file version
    if ! version_file=$(mysql_find_version_file); then
        return 1
    fi

    if ! version=$(mysql_get_version "$version_file"); then
        return 1
    fi
    declare -r version_file version

    if ! is-at-least 8.0.33 "$version"; then
        # MySQL versions <= 8.0.32 will fail to build if an OpenSSL newer than
        # 1.1 is linked into the Homebrew prefix, because its headers there take
        # precedence over the openssl@1.1 ones.
        #
        # The relevant patches in MySQL 8.0.33 are:
        # 19b8d5478e7 Bug#35057542 Create INTERFACE libraries for bundled/system
        # zlib/zstd/lz4
        # 486ff96e325 Bug#35057542 Create INTERFACE libraries for bundled/system
        # zlib/zstd/lz4
        # bbf1d64b728 Bug#35057542 Create INTERFACE libraries for bundled/system
        # zlib/zstd/lz4
        # 1f2b9d62feb Bug#35057542 Create INTERFACE libraries for bundled/system
        # zlib/zstd/lz4
        echo 1
    else
        echo 0
    fi

    return 0
}
