{
  "permissions": {
    "allow": [
      "mcp__elisp-dev__elisp-describe-function",
      "mcp__elisp-dev__elisp-info-lookup-symbol",
      "Bash(find:*)",
      "Bash(ls:*)",
      "mcp__elisp-dev__elisp-describe-variable",
      "Bash(readlink:*)",
      "Bash(mkdir:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(gh repo view:*)",
      "Bash(gh auth refresh:*)",
      "Bash(checkov:*)",
      "Bash(./check.sh)",
      "Bash(zizmor:*)",
      "WebSearch",
      "Bash(prettier:*)",
      "Bash(git log:*)",
      "Bash(cat:*)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/validate_check_sh.py",
            "if": "Bash(./check.sh *)"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/validate_elisp_syntax.py",
            "if": "Write(*.el)"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/validate_elisp_syntax.py",
            "if": "Edit(*.el)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
