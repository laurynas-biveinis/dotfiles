{
  "threshold": 0,
  "reporters": ["consoleFull"],
  "ignore": [
    "**/__snapshots__/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/.emacs.d/elpa/**",
    "**/.venv/**",
    "**/mysql-work/.zsh.d/rc/mysql-work.sh",
    "**/zsh/.p10k.zsh",
    "**/zsh/.zshrc"
  ],
  "ignorePattern": [
    "(?s)description: >-\\n  Internal step of inspect-changes:.*?Glob"
  ],
  "absolute": true
}
