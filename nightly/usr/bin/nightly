#!/bin/zsh

set -euo pipefail

declare -i nightly_status=0
for nightly_script in "$HOME"/.nightly/*; do
	echo "Running nightly $nightly_script..."
	if ! "$nightly_script"; then
		echo "Nightly script failed: $nightly_script" >&2
		nightly_status=1
	fi
done

if ((nightly_status)); then
	echo "Nightly completed with failures!" >&2
	exit 1
fi
echo "Nightly completed!"
